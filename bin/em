#!/usr/bin/env node
/**
 * EventMath CLI v0.2
 *
 * Usage:
 *   em <command> [options] <file>
 *
 * Commands:
 *   compile <file>     Compile .em → .em.js
 *   format  <file>     Format .em in place
 *   run     <file>     Compile + execute
 *   debug   <file>     Launch Mender debugger
 *   check   <file>     Parse only, report errors
 *   help               Show this help
 */

const fs = require('fs');
const path = require('path');

const ROOT = path.resolve(__dirname, '..');
const { EventMathTokenizer } = require(path.join(ROOT, 'src/tokenizer.js'));
const { EventMathParser } = require(path.join(ROOT, 'src/parser.js'));
const { EventMathCodeGen } = require(path.join(ROOT, 'src/codegen.js'));
const { EventMathFormatter } = require(path.join(ROOT, 'src/formatter.js'));
const { EventMathValidator } = require(path.join(ROOT, 'src/validator.js'));
const { EventMathSystemMap } = require(path.join(ROOT, 'src/system-map.js'));
const { EventMathWhy } = require(path.join(ROOT, 'src/why.js'));

function die(msg) {
  console.error(msg);
  process.exit(1);
}

function readFileOrStdin(file) {
  const src = file && file !== '-'
    ? fs.readFileSync(path.resolve(file), 'utf-8')
    : fs.readFileSync(0, 'utf-8');
  return src;
}

function parseEM(src, file) {
  const tokenizer = new EventMathTokenizer();
  const tokens = tokenizer.tokenize(src);
  const parser = new EventMathParser(tokens);
  const ast = parser.parse();

  if (ast.errors && ast.errors.length > 0) {
    for (const err of ast.errors) {
      const msg = typeof err === 'string' ? err : (err.message || JSON.stringify(err));
      console.error(file ? `${file}: ${msg}` : msg);
    }
    return null;
  }
  return ast;
}

// ── Dependency compilation ────────────────────────────────

function compileDependencies(ast, mainFilePath, compiled) {
  if (!compiled) compiled = new Set();
  const dir = path.dirname(path.resolve(mainFilePath));
  const useStmts = ast.statements.filter(s => s.type === 'Use');

  for (const stmt of useStmts) {
    const depPath = path.resolve(dir, stmt.from);
    if (compiled.has(depPath)) continue; // avoid circular deps

    if (!fs.existsSync(depPath)) {
      console.warn(`  Warning: referenced file "${stmt.from}" not found`);
      continue;
    }

    compiled.add(depPath);

    // Recursively compile this dependency
    const depSrc = fs.readFileSync(depPath, 'utf-8');
    const tokenizer = new EventMathTokenizer();
    const depAst = new EventMathParser(tokenizer.tokenize(depSrc)).parse();
    if (!depAst) continue;

    // Compile its dependencies first
    compileDependencies(depAst, depPath, compiled);

    // Compile the dependency itself
    const depOutPath = depPath.replace(/\.em$/, '.em.js');
    if (!fs.existsSync(depOutPath)) {
      const gen = new EventMathCodeGen();
      const depJs = gen.generate(depAst);
      fs.writeFileSync(depOutPath, depJs);
      console.log(`  Compiled dependency: ${path.relative(process.cwd(), depPath)}`);
    }
  }
}

// ── Commands ─────────────────────────────────────────────

function cmdHelp() {
  console.log(`
EventMath v0.2 — CLI

  em compile [options] <file>    Compile .em → .em.js
    -o, --output <path>           Output path (default: <file>.js)
    --target <node|bun>           Codegen target (default: node)
    -w, --watch                   Watch for changes (NYI)
    --map                         Emit system map JSON alongside compiled JS
    --map-only                    Emit system map JSON only (skip JS compilation)

  em format <file>               Format .em in place
    -c, --check                   Only check format (exit 1 if not canonical)
    -d, --diff                    Show diff instead of rewriting

  em run <file>                  Compile + execute
    --no-runtime                  Skip runtime import (standalone JS)

  em map <file>                  Emit system map (dependency graph) as JSON
    -o, --output <path>           Output path (default: stdout)
    --pretty                      Pretty-print JSON

  em why [options] <name> <file> Explain a signal, lens, cloud, or action
    -r, --report                  Show full annotated report of all nodes

  em debug <file>                Launch Mender debugger

  em check <file>                Parse only, report syntax errors
    -v, --verbose                 Show token + AST info

  em help                        Show this help
`);
}

// ── compile ───────────────────────────────────────────────

function cmdCompile(file, opts) {
  const src = readFileOrStdin(file);
  const ast = parseEM(src, file);
  if (!ast) process.exit(1);

  // Semantic validation (non-blocking in alpha — print but don't stop compile)
  const validator = new EventMathValidator();
  const validation = validator.validate(ast);
  if (validation.errors.length > 0) {
    for (const err of validation.errors) console.warn('  Semantic warning:', err);
  }
  if (validation.warnings.length > 0) {
    for (const w of validation.warnings) console.warn('  Warning:', w);
  }

  // Compile dependencies first (use statements)
  if (file && file !== '-') {
    compileDependencies(ast, file, new Set());
  }

  const output = opts.output || (file && file !== '-'
    ? file.replace(/\.em$/, '') + '.em.js'
    : null);

  // ── System map (dependency graph) ──
  if (opts.map || opts.mapOnly) {
    const mapper = new EventMathSystemMap();
    const graph = mapper.build(ast);
    const mapJson = JSON.stringify(graph, null, 2);
    const mapOutput = output
      ? output.replace(/\.em\.js$/, '') + '.system-map.json'
      : null;

    if (mapOutput) {
      fs.writeFileSync(path.resolve(mapOutput), mapJson, 'utf-8');
      console.log(`🗺️  Wrote system map to ${mapOutput} (${graph.nodes.length} nodes, ${graph.edges.length} edges)`);
    } else {
      process.stdout.write(mapJson + '\n');
    }
  }

  if (opts.mapOnly) return;

  const target = opts.target || 'node';
  if (target !== 'node' && target !== 'bun') {
    die(`Unknown target: ${target} (expected 'node' or 'bun')`);
  }

  // Compute the runtime path relative to the actual output location so the
  // compiled file runs from anywhere — no hardcoded sibling-directory path.
  let runtimePath = '../runtime/eventmath-runtime.js';
  if (output) {
    const runtimeAbs = path.join(ROOT, 'runtime/eventmath-runtime.js');
    runtimePath = path.relative(path.dirname(path.resolve(output)), runtimeAbs);
    if (!runtimePath.startsWith('.')) runtimePath = './' + runtimePath;
  }

  // Compute the security runtime path relative to the output location.
  let securityRuntimePath = '../security/eventmath-security-runtime.js';
  if (output) {
    const securityRuntimeAbs = path.join(ROOT, 'security/eventmath-security-runtime.js');
    securityRuntimePath = path.relative(path.dirname(path.resolve(output)), securityRuntimeAbs);
    if (!securityRuntimePath.startsWith('.')) securityRuntimePath = './' + securityRuntimePath;
  }

  const codegen = new EventMathCodeGen();
  const js = codegen.generate(ast, { target, runtimePath, securityRuntimePath });

  if (output) {
    fs.writeFileSync(path.resolve(output), js, 'utf-8');
    if (target === 'bun') {
      try { fs.chmodSync(path.resolve(output), 0o755); } catch (e) { /* best effort */ }
    }
    const how = target === 'bun' ? `bun ${output}` : `node ${output}`;
    console.log(`✅ Wrote ${output} (${js.split('\n').length} lines, target: ${target}) — run: ${how}`);
  } else {
    process.stdout.write(js);
  }
}

// ── format ───────────────────────────────────────────────

function cmdFormat(file, opts) {
  const resolved = path.resolve(file);
  const src = fs.readFileSync(resolved, 'utf-8');

  const tokenizer = new EventMathTokenizer();
  const tokens = tokenizer.tokenize(src);
  const parser = new EventMathParser(tokens);
  const ast = parser.parse();

  if (ast.errors && ast.errors.length > 0) {
    for (const err of ast.errors) {
      const msg = typeof err === 'string' ? err : (err.message || JSON.stringify(err));
      console.error(`${file}: ${msg}`);
    }
    process.exit(1);
  }

  const formatter = new EventMathFormatter();
  const formatted = formatter.format(ast) + '\n';

  if (opts.check) {
    if (src === formatted) {
      console.log(`✅ ${file} — canonical`);
      process.exit(0);
    } else {
      console.log(`❌ ${file} — needs formatting`);
      // Show diff context
      const srcLines = src.split('\n');
      const fmtLines = formatted.trimEnd().split('\n');
      for (let i = 0; i < Math.min(srcLines.length, fmtLines.length); i++) {
        if (srcLines[i] !== fmtLines[i]) {
          console.log(`  Line ${i + 1}:`);
          console.log(`  - ${srcLines[i]}`);
          console.log(`  + ${fmtLines[i]}`);
        }
      }
      process.exit(1);
    }
  } else if (opts.diff) {
    // Show unified diff
    const srcLines = src.split('\n');
    const fmtLines = formatted.trimEnd().split('\n');
    for (let i = 0; i < Math.max(srcLines.length, fmtLines.length); i++) {
      const a = srcLines[i] || '';
      const b = fmtLines[i] || '';
      if (a !== b) {
        process.stdout.write(`@@ ${i + 1} @@\n`);
        process.stdout.write(`-${a}\n`);
        process.stdout.write(`+${b}\n`);
      }
    }
  } else {
    fs.writeFileSync(resolved, formatted, 'utf-8');
    console.log(`✅ Formatted ${file}`);
  }
}

// ── run ──────────────────────────────────────────────────

function cmdRun(file, opts) {
  // Compile to temp
  const src = readFileOrStdin(file);
  const ast = parseEM(src, file);
  if (!ast) process.exit(1);

  // Compile dependencies first (use statements)
  if (file && file !== '-') {
    compileDependencies(ast, file, new Set());
  }

  const codegen = new EventMathCodeGen();
  let js = codegen.generate(ast);

  // Write to temp and run
  const tmpFile = path.join('/tmp', 'em-run-' + Date.now() + '.js');
  js = js.replace(
    "require('../runtime/eventmath-runtime.js')",
    `require('${path.join(ROOT, 'runtime/eventmath-runtime.js')}')`
  );
  fs.writeFileSync(tmpFile, js, 'utf-8');

  try {
    require(tmpFile);
    process.exit(0);
  } catch (e) {
    console.error(`Runtime error: ${e.message}`);
    process.exit(1);
  }
}

// ── check ────────────────────────────────────────────────

function cmdCheck(file, opts) {
  const src = readFileOrStdin(file);
  const tokenizer = new EventMathTokenizer();
  const tokens = tokenizer.tokenize(src);
  const parser = new EventMathParser(tokens);
  const ast = parser.parse();

  if (opts.verbose) {
    console.log(`Tokens: ${tokens.length}`);
    for (const t of tokens) {
      console.log(`  ${t.type}: ${t.value} (line ${t.line})`);
    }
    console.log('');
  }

  if (ast.errors && ast.errors.length > 0) {
    for (const err of ast.errors) {
      const msg = typeof err === 'string' ? err : (err.message || JSON.stringify(err));
      console.error(file ? `${file}: ${msg}` : msg);
    }
    process.exit(1);
  }

  // Semantic validation
  const validator = new EventMathValidator();
  const validation = validator.validate(ast);
  if (validation.errors.length > 0) {
    for (const err of validation.errors) console.error('  Error:', err);
  }
  if (validation.warnings.length > 0) {
    for (const w of validation.warnings) console.warn('  Warning:', w);
  }

  if (opts.verbose) {
    console.log(`Statements: ${ast.statements.length}`);
    for (const s of ast.statements) {
      console.log(`  ${s.type}: ${s.name || s.target || '(unnamed)'}`);
    }
  } else {
    console.log(`✅ ${file || 'stdin'} — valid`);
  }
}

// ── debug (alias for Mender) ─────────────────────────────

function cmdDebug(file) {
  const resolved = path.resolve(file);
  const menderPath = path.join(ROOT, 'mender/mender.js');
  // Spawn as child process so Mender can use readline interactively
  const { spawn } = require('child_process');
  const child = spawn(process.execPath, [menderPath, resolved], {
    stdio: 'inherit',
    cwd: ROOT,
  });
  child.on('exit', (code) => process.exit(code || 0));
}

// ── map ──────────────────────────────────────────────────

function cmdMap(file, opts) {
  const src = readFileOrStdin(file);
  const ast = parseEM(src, file);
  if (!ast) process.exit(1);

  const mapper = new EventMathSystemMap();
  const graph = mapper.build(ast);
  const mapJson = opts.pretty
    ? JSON.stringify(graph, null, 2)
    : JSON.stringify(graph);

  if (opts.output) {
    fs.writeFileSync(path.resolve(opts.output), mapJson, 'utf-8');
    console.log(`🗺️  Wrote system map to ${opts.output} (${graph.nodes.length} nodes, ${graph.edges.length} edges)`);
  } else {
    process.stdout.write(mapJson + '\n');
  }
}

// ── why ──────────────────────────────────────────────────

function cmdWhy(name, file, opts) {
  if (!name) {
    die('Usage: em why <name> <file>\n  Explain a signal, lens, cloud, or action.');
  }

  const src = readFileOrStdin(file);
  const ast = parseEM(src, file);
  if (!ast) process.exit(1);

  const explainer = new EventMathWhy(ast);

  if (opts.report) {
    console.log(explainer.fullReport());
  } else {
    console.log(explainer.explain(name));
  }
}

// ── Main dispatch ────────────────────────────────────────

function main() {
  const args = process.argv.slice(2);

  if (args.length === 0 || args[0] === 'help' || args[0] === '--help' || args[0] === '-h') {
    cmdHelp();
    return;
  }

  const command = args[0];
  const rest = args.slice(1);

  const opts = {};
  const files = [];

  for (let i = 0; i < rest.length; i++) {
    const a = rest[i];
    if (a === '-o' || a === '--output') {
      opts.output = rest[++i];
    } else if (a === '-c' || a === '--check') {
      opts.check = true;
    } else if (a === '-d' || a === '--diff') {
      opts.diff = true;
    } else if (a === '-v' || a === '--verbose') {
      opts.verbose = true;
    } else if (a === '-w' || a === '--watch') {
      opts.watch = true;
    } else if (a === '--target') {
      opts.target = rest[++i];
    } else if (a === '--no-runtime') {
      opts.noRuntime = true;
    } else if (a === '--map') {
      opts.map = true;
    } else if (a === '--map-only') {
      opts.mapOnly = true;
    } else if (a === '--pretty') {
      opts.pretty = true;
    } else if (a === '-r' || a === '--report') {
      opts.report = true;
    } else if (a.startsWith('-')) {
      die(`Unknown option: ${a}`);
    } else {
      files.push(a);
    }
  }

  const file = files[0] || '-';
  const whyName = (command === 'why') ? (files[0] || '') : null;
  const whyFile = (command === 'why') ? (files[1] || '-') : null;

  switch (command) {
    case 'compile':
      return cmdCompile(whyName || file, opts); // whyName is empty string for non-why commands
    case 'format':
      return cmdFormat(file, opts);
    case 'run':
      return cmdRun(file, opts);
    case 'check':
      return cmdCheck(file, opts);
    case 'debug':
      return cmdDebug(file);
    case 'map':
      return cmdMap(file, opts);
    case 'why':
      return cmdWhy(whyName, whyFile, opts);
    default:
      die(`Unknown command: ${command}\nRun 'em help' for usage.`);
  }
}

main();