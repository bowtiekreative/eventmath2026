note The six directions — how something can change

event direct direction
category compass
matter
  name is direct
  description is same cause produces same effect in same direction
  polarity is positive
end
end

event indirect opposite direction
category compass
matter
  name is indirect opposite
  description is cause produces effect through inversion
  polarity is negative
end
end

event indirect other direction
category compass
matter
  name is indirect other
  description is cause produces effect through a different path
  polarity is lateral
end
end

event keep same direction
category compass
matter
  name is keep same
  description is no change current state persists
  polarity is neutral
end
end

event more same direction
category compass
matter
  name is more same
  description is current state amplified
  polarity is amplified
end
end

event less same direction
category compass
matter
  name is less same
  description is current state diminished
  polarity is diminished
end
end

layer directions
  direct direction
  indirect opposite direction
  indirect other direction
  keep same direction
  more same direction
  less same direction
end
