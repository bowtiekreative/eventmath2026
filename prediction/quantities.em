note The six quantities — how much of something is involved

event one quantity
category quantity
matter
  name is one
  description is exactly one instance or unit
  scope is singular
end
end

event partial quantity
category quantity
matter
  name is partial
  description is some but not all
  scope is subset
end
end

event many quantity
category quantity
matter
  name is many
  description is a large number of instances
  scope is plural
end
end

event any quantity
category quantity
matter
  name is any
  description is one or more regardless of which
  scope is existential
end
end

event none quantity
category quantity
matter
  name is none
  description is zero instances or absence
  scope is empty
end
end

event all quantity
category quantity
matter
  name is all
  description is the complete set without exception
  scope is universal
end
end

layer quantities
  one quantity
  partial quantity
  many quantity
  any quantity
  none quantity
  all quantity
end
